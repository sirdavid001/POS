# Database
DATABASE_URL=postgresql://pos_user:pos_password@localhost:5432/pos_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
PORT=3001
NODE_ENV=development
# Comma-separated exact origins. Include each deployed site and installed-app origin.
CORS_ORIGIN=http://localhost:5173,http://localhost,https://localhost,capacitor://localhost,null,https://pos-client-ruddy.vercel.app,https://quickposs.vercel.app,https://quickpos.com.ng,https://www.quickpos.com.ng,https://pos-website-sirdavids-projects.vercel.app,https://pos-website-sirdavid001-sirdavids-projects.vercel.app

# Merchant subscription billing
# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PLAN_MONTHLY=PLN_xxxxxxxxx
PAYSTACK_PLAN_QUARTERLY=PLN_xxxxxxxxx
PAYSTACK_PLAN_YEARLY=PLN_xxxxxxxxx

# Flutterwave
# Generate a new secret key in Flutterwave. Never reuse a key shared in chat.
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxx-X
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxx-X
FLUTTERWAVE_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
FLUTTERWAVE_PLAN_MONTHLY=00000
FLUTTERWAVE_PLAN_QUARTERLY=00000
FLUTTERWAVE_PLAN_YEARLY=00000

# Billing
BILLING_RETURN_URL=https://quickpos.com.ng/account#billing
CRON_SECRET=replace-with-a-random-cron-secret
# Nigeria is billed in NGN; every other country is billed in USD.
# Only list currencies your active provider account is enabled to accept.
PAYSTACK_SUPPORTED_CURRENCIES=NGN,USD
FLUTTERWAVE_SUPPORTED_CURRENCIES=NGN,USD
# Prices use major units. Checkout never falls back to NGN for a foreign customer.
BILLING_CURRENCY_PRICES={}
# Defaults: activation NGN 20,000 / USD 15; monthly NGN 5,000 / USD 4;
# quarterly NGN 13,500 / USD 10; yearly NGN 50,000 / USD 38.
# Override example: BILLING_CURRENCY_PRICES={"USD":{"activation_5m":15,"monthly":4,"quarterly":10,"yearly":38}}
# Recurring USD plans need provider-specific USD plan IDs.
PAYSTACK_PLAN_MONTHLY_USD=
PAYSTACK_PLAN_QUARTERLY_USD=
PAYSTACK_PLAN_YEARLY_USD=
FLUTTERWAVE_PLAN_MONTHLY_USD=
FLUTTERWAVE_PLAN_QUARTERLY_USD=
FLUTTERWAVE_PLAN_YEARLY_USD=

# Download release manifest used by the authenticated website account portal
DOWNLOADS_MANIFEST_URL=https://downloads.quickpos.com.ng/latest.json
GITHUB_LATEST_RELEASE_URL=https://api.github.com/repos/sirdavid001/POS/releases/latest
IOS_WEB_APP_URL=https://quickposs.vercel.app

# Store sales statement email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=QuickPOS <billing@quickpos.com.ng>
EMAIL_REPLY_TO=support@quickpos.com.ng

# Password recovery
PASSWORD_RESET_URL=https://quickpos.com.ng/account#reset-password
PASSWORD_RESET_EXPIRY_MINUTES=30

# Optional local/demo seed account. Never set public credentials in source control.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Frontend
# Both the website account portal and every POS app build must use this same API.
# Local development may keep localhost; production should use the deployed server.
VITE_API_URL=http://localhost:3001/api/v1
VITE_WS_URL=ws://localhost:3001
VITE_RELEASE_MANIFEST_URL=https://downloads.quickpos.com.ng/latest.json
VITE_DOWNLOADS_URL=https://quickpos.com.ng/downloads
